# Database
DATABASE_URL=sqlite:///./sr_agro.db

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Uploads
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE=524288000
