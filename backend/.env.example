# =============================================================================
# SR AGRO VISION — BACKEND ENVIRONMENT (ejemplo)
# Copiar como .env y completar los valores reales
# =============================================================================

# Logging (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///./sr_agro.db

# Security — generar con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Uploads
# Paths are relative to the CWD where uvicorn/celery run (backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=524288000
SR_OUTPUT_DIR=uploads/results

# Celery / Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Copernicus (opcional — solo si usás descarga satelital)
# COPERNICUS_CLIENT_ID=tu_client_id
# COPERNICUS_CLIENT_SECRET=tu_client_secret
